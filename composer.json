{
  "name": "gcworld/orm",
  "description": "GCWorld Industries ORM",
  "authors": [
    {
      "name": "GameCharmer",
      "email": "admin@gamecharmer.com"
    }
  ],
  "require": {
    "php": ">=8.4",
    "ext-json": "*",
    "ext-pdo": "*",
    "gcworld/common": "^2.7",
    "gcworld/globals": "^4.0",
    "gcworld/interfaces": "^4.4",
    "gcworld/database": "^2.7",
    "composer/composer": "^2.10",
    "composer/installers": "^2.3",
    "symfony/yaml": "^6.4",
    "ramsey/uuid": "^4.9",
    "monolog/monolog": "^3.10",
    "nette/php-generator": "^4.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^4.0",
    "phpmd/phpmd": "^2.15",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "autoload": {
    "psr-4": {"GCWorld\\ORM\\": "src/"}
  },
  "autoload-dev": {
    "psr-4": {"GCWorld\\ORM\\Tests\\": "tests/"}
  },
  "scripts": {
    "post-autoload-dump": [
      "bash contrib/setup.sh",
      "GCWorld\\ORM\\ComposerInstaller::setupConfig"
    ],
    "post-install-cmd": [
      "bash contrib/setup.sh"
    ],
    "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "test": "phpunit",
    "check": [
      "@lint",
      "@phpstan",
      "@phpcs",
      "@test"
    ]
  },
  "license":"MIT",
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
